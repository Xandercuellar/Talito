# Copia este archivo como ".env" para personalizar el entorno local.
# Todo es opcional en desarrollo: sin DATABASE_URL se usa una base embebida (PGlite).

# PostgreSQL real (Neon, local...). Déjalo vacío para usar la base embebida.
# DATABASE_URL=postgresql://usuario:clave@host/base?sslmode=require

# Obligatorio en producción
# JWT_SECRET=una-cadena-larga-y-aleatoria

# Primer administrador (solo se crea si aún no hay usuarios)
# ADMIN_EMAIL=admin@talito.test
# ADMIN_PASSWORD=admin1234

# false = no cargar los pedidos de demostración (historial para las gráficas)
# SEED_DEMO=true

# Puerto del servidor
# PORT=3000
